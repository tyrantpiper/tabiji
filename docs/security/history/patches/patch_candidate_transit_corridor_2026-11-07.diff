+def _is_transit_splitter_item(item: Dict[str, Any]) -> bool:
+    """判斷行程項目是否為跨城/跨海轉場交通橋接節點 (ReDoS-Free 常數時間檢測)。"""
+    if not isinstance(item, dict):
