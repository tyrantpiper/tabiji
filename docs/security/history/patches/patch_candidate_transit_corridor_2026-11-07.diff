+        f"{item.get('original_name') or ''} "
+        f"{item.get('notes') or ''} "
+        f"{item.get('desc') or ''}"
+    ).lower()
+    return any(kw in combined for kw in GLOBAL_TRANSIT_SPLIT_KEYWORDS)
