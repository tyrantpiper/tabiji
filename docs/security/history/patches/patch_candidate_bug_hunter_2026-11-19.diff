+    try:
+        db_row = {
+            "id": task_id,
+            "status": status,
+            "output_text": output_text,
+            "error_message": error_message,
+            "engine": engine,
+            "key_hash": key_hash,
+            "updated_at": now_iso,
+        }
+        if status == "running" and "started_at" not in existing:
+            db_row["started_at"] = now_iso
