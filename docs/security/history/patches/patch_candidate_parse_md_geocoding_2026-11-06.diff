+                link = it.get("link_url")
+                if not it["lat"] and link and _is_allowed_maps_url(link):
+                    coords = mol_parser.parse_url(link)
+                    if coords:
+                        it["lat"] = coords["lat"]
+                        it["lng"] = coords["lng"]
+
