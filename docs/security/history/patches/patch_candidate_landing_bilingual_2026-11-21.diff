+
+  describe('2. LanguageContext Storage, Runtime Validation & Interpolation Safety Net', () => {
+    it('isolates localStorage QuotaExceededError from document.cookie sync and vice versa', () => {
+      const { result } = renderHook(() => useLanguage(), {
