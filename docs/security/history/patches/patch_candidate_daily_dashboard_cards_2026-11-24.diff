+// 🛡️ 安全擷取第一個視覺字素 (Grapheme Cluster)，防止 UTF-16 Surrogate Pair 截斷或整句溢位
+function extractFirstGrapheme(input: string): string {
+    const trimmed = input.trim()
+    if (!trimmed) return ""
+    if (typeof Intl !== "undefined" && "Segmenter" in Intl) {
+        const segmenter = new Intl.Segmenter(undefined, { granularity: "grapheme" })
+        const first = segmenter.segment(trimmed)[Symbol.iterator]().next().value
+        if (first?.segment) return first.segment
+    }
+    return Array.from(trimmed)[0] || ""
+}
