+/**
+ * 🛡️ 檢查當前本機是否具備完整之登入使用者身分 (已登入狀態機閘門)
+ */
+export function isUserLoggedIn(): boolean {
+    if (typeof window === "undefined") return false;
+    try {
+        return Boolean(localStorage.getItem("user_nickname") && localStorage.getItem(RECOVERY_KEY));
+    } catch {
+        return false;
+    }
+}
