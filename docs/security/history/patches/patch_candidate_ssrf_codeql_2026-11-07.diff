+            for _, _, _, _, sockaddr in addr_info:
+                ip = sockaddr[0]
+                if not is_ip_safe(ip):
+                    return None
+            return str(addr_info[0][4][0])
+        except (socket.gaierror, socket.herror, OSError):
             return None
              
     except Exception:
         return None
+
+async def _enforce_request_ssrf_safety(request: httpx.Request):
+    """
+    🛡️ HTTP 傳輸層物理守門員：
+    在連線發送前觸發（支援 initial request 與每一跳重定向 target）。
+    若目標解析為私有/雲端 Metadata 網段，物理阻斷 TCP 連線建立。
+    """
+    target_url = str(request.url)
+    if not is_safe_url(target_url):
+        raise SSRFSecurityError(f"[SSRF Blocked] Outbound connection to {target_url} was physically aborted.")
+
+def create_safe_client(**kwargs) -> httpx.AsyncClient:
+    """工廠函式：產出具備 SSRF 自癒與重定向實體攔截的 httpx 客戶端"""
+    hooks = kwargs.pop("event_hooks", {})
+    request_hooks = hooks.get("request", [])
+    if _enforce_request_ssrf_safety not in request_hooks:
+        request_hooks.append(_enforce_request_ssrf_safety)
+    hooks["request"] = request_hooks
+    
+    kwargs.setdefault("timeout", httpx.Timeout(10.0, connect=3.0))
+    kwargs["event_hooks"] = hooks
+    return httpx.AsyncClient(**kwargs)
