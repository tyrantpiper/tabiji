+    candidates: list[str] = []
+    for env_name in ("LEGACY_SESSION_SECRET_KEY", "PREVIOUS_SESSION_SECRET_KEY"):
+        raw = os.getenv(env_name, "")
+        for part in raw.split(","):
+            s = part.strip()
+            if s and len(s) >= 16 and s != current_secret and s not in candidates:
+                candidates.append(s)
+    return candidates
+
