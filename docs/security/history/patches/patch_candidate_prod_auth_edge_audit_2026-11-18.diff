+    required_claims = ["sub", "iss", "iat", "exp", "type"] if verify_exp else ["sub", "iss", "iat", "type"]
+    for cand_secret in secrets_to_try:
+        try:
+            payload = jwt.decode(
+                token,
+                cand_secret,
+                algorithms=["HS256"],
+                issuer="tabiji-core",
+                options={"verify_exp": verify_exp, "require": required_claims},
