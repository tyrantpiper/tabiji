+def extract_valid_user_id(raw_client_id: str) -> Optional[str]:
+    """
+    從 client_id 提取並驗證合法的 user_id (UUID)：
+    1. 若直接為合法 UUID，去除空白後返回。
+    2. 若使用者誤將連線憑證 (JWT) 填入 Client ID，自動驗章並提取其 sub (UUID)。
