+    cleaned = raw_client_id.strip()
+    if is_valid_uuid(cleaned):
+        return cleaned
+    if cleaned.startswith("ey"):
+        try:
+            payload = jwt.decode(
+                cleaned,
+                get_session_secret(),
+                algorithms=["HS256"],
+                issuer="tabiji-core"
+            )
+            sub = payload.get("sub")
+            if is_valid_uuid(sub):
+                return sub.strip()
+        except Exception:
+            pass
+    return None
