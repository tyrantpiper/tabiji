+    # 若為全球未知城市且無既有座標，承接原 ai.py Step 1/Step 2 透過 smart_geocode_logic (含快取、Photon、Nominatim 備援與國碼推斷) 動態解析中心點
+    if (anchor_lat is None or anchor_lng is None) and region_name:
