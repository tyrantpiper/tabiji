@@ -14,6 +14,27 @@
 let inFlightSessionPromise: Promise<string | null> | null = null;
 
+/**
+ * 跨分頁安全換票排程器 (具備 Feature Detection 與 5s 逾時降級)
+ */
+async function withCrossTabLock<T>(lockName: string, timeoutMs: number, fn: () => Promise<T>): Promise<T> {
+    if (typeof navigator !== "undefined" && "locks" in navigator && typeof navigator.locks?.request === "function") {
+        const controller = new AbortController();
+        const timeoutId = setTimeout(() => controller.abort(), timeoutMs);
+        try {
+            return await navigator.locks.request(lockName, { signal: controller.signal }, async () => {
+                clearTimeout(timeoutId);
+                return await fn();
+            });
+        } catch (err: any) {
+            clearTimeout(timeoutId);
+            if (err?.name === "AbortError") {
+                console.warn(`⏳ [Auth] WebLock '${lockName}' timed out after ${timeoutMs}ms. Fallback to direct execution.`);
+            }
+            return await fn();
+        }
+    }
+    return await fn();
+}
