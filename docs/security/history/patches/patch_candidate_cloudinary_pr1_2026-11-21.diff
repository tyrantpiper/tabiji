+function createMockJwt(payload: Record<string, unknown>): string {
+    const enc = (obj: Record<string, unknown>) =>
+        btoa(JSON.stringify(obj)).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '')
+    return `${enc({ alg: 'HS256', typ: 'JWT' })}.${enc(payload)}.mock_sig`
+}
