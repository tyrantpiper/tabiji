+// 🛡️ 模組級單例頻道協調器 (保證連線建立期廣播不丟包)
+class RealtimeChannelCoordinator {
+    private static instance: RealtimeChannelCoordinator | null = null;
+    private channel: any = null;
+    private status: "DISCONNECTED" | "CONNECTING" | "SUBSCRIBED" = "DISCONNECTED";
+    private queue: Array<{ event: string; payload: Record<string, unknown> }> = [];
+
+    public static get(): RealtimeChannelCoordinator {
+        if (!RealtimeChannelCoordinator.instance) {
+            RealtimeChannelCoordinator.instance = new RealtimeChannelCoordinator();
+        }
+        return RealtimeChannelCoordinator.instance;
+    }
+
+    public attach(channel: any) {
+        this.channel = channel;
+        this.status = "CONNECTING";
+    }
+
+    public setSubscribed() {
+        this.status = "SUBSCRIBED";
+        while (this.queue.length > 0) {
+            const item = this.queue.shift();
+            if (item && this.channel) {
+                this.channel.send({ type: "broadcast", event: item.event, payload: item.payload }).catch(() => {});
+            }
+        }
+    }
+
+    public async broadcast(event: string, payload: Record<string, unknown>) {
+        if (this.status === "SUBSCRIBED" && this.channel) {
+            try {
+                const res = await this.channel.send({ type: "broadcast", event, payload });
+                if (res === "ok") return;
+            } catch {}
+        }
+        this.queue.push({ event, payload });
+    }
+}
