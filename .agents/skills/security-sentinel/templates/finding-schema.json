{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SecuritySentinelFinding",
  "type": "object",
  "required": ["id", "title", "severity", "target_file", "validator_verdict", "poc_type", "poc_script", "remediation_strategy"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "severity": { "type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFORMATIONAL"] },
    "cwe": { "type": "string" },
    "target_file": { "type": "string" },
    "line_range": { "type": "string" },
    "attack_vector": { "type": "string" },
    "hypothesis": { "type": "string" },
    "validator_verdict": { "type": "string", "enum": ["CONFIRMED", "DISMISSED", "INCONCLUSIVE"] },
    "poc_type": { "type": "string", "enum": ["pytest_in_memory", "unit_test", "none"] },
    "poc_script": { "type": ["string", "null"] },
    "remediation_strategy": { "type": "string" },
    "patch_candidate": { "type": ["string", "null"] },
    "block_replacement": {
      "type": ["object", "null"],
      "properties": {
        "target_file": { "type": "string" },
        "target_content": { "type": "string" },
        "replacement_content": { "type": "string" }
      }
    }
  }
}
